<idea-plugin>
    <id>asia.damun.verifylens</id>
    <name>VerifyLens</name>
    <vendor url="https://github.com/DamunKorea/verifylens">DAMUN</vendor>

    <description><![CDATA[
<p><b>See per requirement whether an AI-generated change is verified, different, or not yet verified, before you commit.</b></p>
<p>AI tools say "Done, all requirements implemented." VerifyLens checks that claim against your working tree and the tests that actually ran,
and shows the result in a tool window and next to the code line that decides each requirement,
for example <code>← R2 · 다름 · 6번째 시도에 동작 (요구사항 5회) · 검사 실패</code>.</p>
<ul>
<li><b>No LLM, and your code never leaves your machine.</b> Static analysis + git + your JUnit test results, all local. No telemetry.</li>
<li><b>Unknown stays unknown.</b> No test or an unresolved call means "not verified", never "looks fine".</li>
<li><b>Same engine as the VS Code extension</b>, so both editors give the same verdict.</li>
</ul>
<p>Preview. Analyzes <b>TypeScript and JavaScript</b>. Needs <b>Node.js 18+</b> and git on this machine. The UI text is currently Korean.</p>
<p>AI가 「완료」라고 한 변경이 요구사항마다 확인됨 · 다름 · 미확인인지, 커밋하기 전에 에디터에서 보여 줍니다.
AI 판정 없이 코드 분석과 실제로 돌린 테스트 결과만 쓰고, 코드는 PC 밖으로 나가지 않습니다.</p>
]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="VerifyLens" anchor="left" secondary="true"
                    icon="asia.damun.verifylens.VerifyLensIcons.ToolWindow"
                    factoryClass="asia.damun.verifylens.VerifyLensToolWindowFactory"/>
        <notificationGroup id="VerifyLens" displayType="BALLOON"/>
        <editor.linePainter implementation="asia.damun.verifylens.VerifyLensLinePainter"/>
        <postStartupActivity implementation="asia.damun.verifylens.AutoRun"/>
    </extensions>

    <actions>
        <action id="VerifyLens.CheckChanges" class="asia.damun.verifylens.CheckChangesAction"
                text="내 변경 확인" description="작업 폴더(커밋 전 변경 포함)를 기준 브랜치와 비교해 요구사항마다 확인합니다"
                icon="AllIcons.Actions.Find">
            <synonym text="VerifyLens: Check my changes"/>
        </action>
        <action id="VerifyLens.RunDemo" class="asia.damun.verifylens.RunDemoAction"
                text="샘플로 해 보기" description="내 코드 없이 로그인 잠금 예로 VerifyLens 를 봅니다"
                icon="AllIcons.Actions.Execute">
            <synonym text="VerifyLens: Run demo"/>
        </action>
        <action id="VerifyLens.Recheck" class="asia.damun.verifylens.RecheckAction"
                text="다시 확인" description="마지막에 한 확인을 다시 합니다"
                icon="AllIcons.Actions.Refresh">
            <synonym text="VerifyLens: Re-check"/>
        </action>
        <action id="VerifyLens.CreateRequirements" class="asia.damun.verifylens.CreateRequirementsAction"
                text="요구사항 파일 만들기" description=".verifylens/requirements.md 를 예시와 함께 만들고 엽니다">
            <synonym text="VerifyLens: Create requirements file"/>
        </action>
        <action id="VerifyLens.SetNodePath" class="asia.damun.verifylens.SetNodePathAction"
                text="Node 위치 지정…" description="분석 엔진을 돌릴 Node.js 실행 파일을 고릅니다">
            <synonym text="VerifyLens: Set Node.js path"/>
        </action>

        <group id="VerifyLens.Toolbar">
            <reference ref="VerifyLens.CheckChanges"/>
            <reference ref="VerifyLens.RunDemo"/>
            <reference ref="VerifyLens.Recheck"/>
        </group>

        <group id="VerifyLens.Menu" text="VerifyLens" popup="true">
            <reference ref="VerifyLens.CheckChanges"/>
            <reference ref="VerifyLens.RunDemo"/>
            <reference ref="VerifyLens.Recheck"/>
            <separator/>
            <reference ref="VerifyLens.CreateRequirements"/>
            <reference ref="VerifyLens.SetNodePath"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
