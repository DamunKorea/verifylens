{
  "name": "verifylens",
  "displayName": "VerifyLens",
  "description": "A rule check for each requirement, next to your AI reviewer: verified, different or not yet verified, with the exact code line and the tests that ran. No LLM, same input same verdict, local.",
  "version": "0.27.2",
  "publisher": "damun",
  "license": "MIT",
  "icon": "media/icon.png",
  "preview": true,
  "galleryBanner": {
    "color": "#0F1B30",
    "theme": "dark"
  },
  "qna": "https://github.com/DamunKorea/verifylens/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/DamunKorea/verifylens"
  },
  "homepage": "https://github.com/DamunKorea/verifylens",
  "bugs": {
    "url": "https://github.com/DamunKorea/verifylens/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode only the demo runs. Checking or comparing branches reads your repository with git and needs a trusted folder.",
      "restrictedConfigurations": [
        "verifylens.nodePath",
        "verifylens.junitPath",
        "verifylens.requirementsFile",
        "verifylens.ghPath",
        "verifylens.testCommand"
      ]
    }
  },
  "categories": [
    "Testing",
    "Linters",
    "Other"
  ],
  "keywords": [
    "ai",
    "verification",
    "code review",
    "requirements",
    "acceptance criteria",
    "copilot",
    "cursor",
    "claude",
    "ai coding",
    "test",
    "typescript",
    "javascript",
    "pull request"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "verifylens.runDemo",
        "title": "Run demo (sample login-lockout case)",
        "category": "VerifyLens",
        "icon": "$(play)"
      },
      {
        "command": "verifylens.checkBranch",
        "title": "Check my changes (current branch, including uncommitted)",
        "category": "VerifyLens",
        "icon": "$(search)"
      },
      {
        "command": "verifylens.compareBranches",
        "title": "Compare two branches",
        "category": "VerifyLens",
        "icon": "$(git-compare)"
      },
      {
        "command": "verifylens.openReport",
        "title": "Open report",
        "category": "VerifyLens",
        "icon": "$(preview)"
      },
      {
        "command": "verifylens.createRequirements",
        "title": "Create requirements file",
        "category": "VerifyLens",
        "icon": "$(new-file)"
      },
      {
        "command": "verifylens.rerun",
        "title": "Run again",
        "category": "VerifyLens",
        "icon": "$(refresh)"
      },
      {
        "command": "verifylens.focusRequirement",
        "title": "Show evidence for a requirement",
        "category": "VerifyLens",
        "icon": "$(preview)",
        "enablement": "verifylens.hasRun"
      },
      {
        "command": "verifylens.openDiff",
        "title": "Compare side by side (A ↔ B, or base ↔ branch)",
        "category": "VerifyLens",
        "icon": "$(git-compare)",
        "enablement": "verifylens.hasRun"
      },
      {
        "command": "verifylens.recordJudgment",
        "title": "Record my decision (use / fix / verify more / hold)",
        "category": "VerifyLens",
        "icon": "$(checklist)",
        "enablement": "verifylens.hasRun"
      },
      {
        "command": "verifylens.copySummary",
        "title": "Copy verification summary for a PR",
        "category": "VerifyLens",
        "icon": "$(clippy)",
        "enablement": "verifylens.hasRun"
      },
      {
        "command": "verifylens.importRequirements",
        "title": "Import requirements (GitHub PR, issue, or copied text)",
        "category": "VerifyLens",
        "icon": "$(cloud-download)"
      },
      {
        "command": "verifylens.runTests",
        "title": "Run tests and re-check",
        "category": "VerifyLens",
        "icon": "$(beaker)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "verifylens",
          "title": "VerifyLens",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "verifylens": [
        {
          "id": "verifylens.requirements",
          "name": "%view.requirements%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "verifylens.requirements",
        "when": "isWorkspaceTrusted",
        "contents": "%welcome.trusted%"
      },
      {
        "view": "verifylens.requirements",
        "when": "!isWorkspaceTrusted",
        "contents": "%welcome.untrusted%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "verifylens.copySummary",
          "when": "view == verifylens.requirements && verifylens.hasRun",
          "group": "navigation@0"
        },
        {
          "command": "verifylens.runTests",
          "when": "view == verifylens.requirements && verifylens.hasRun",
          "group": "navigation@0"
        },
        {
          "command": "verifylens.rerun",
          "when": "view == verifylens.requirements && verifylens.hasRun",
          "group": "navigation@1"
        },
        {
          "command": "verifylens.openReport",
          "when": "view == verifylens.requirements && verifylens.hasRun",
          "group": "navigation@2"
        },
        {
          "command": "verifylens.checkBranch",
          "when": "view == verifylens.requirements",
          "group": "1_run@1"
        },
        {
          "command": "verifylens.compareBranches",
          "when": "view == verifylens.requirements",
          "group": "1_run@2"
        },
        {
          "command": "verifylens.runDemo",
          "when": "view == verifylens.requirements",
          "group": "1_run@3"
        },
        {
          "command": "verifylens.importRequirements",
          "when": "view == verifylens.requirements",
          "group": "1_run@0"
        }
      ],
      "view/item/context": [
        {
          "command": "verifylens.openDiff",
          "when": "view == verifylens.requirements && viewItem == requirement",
          "group": "inline@1"
        },
        {
          "command": "verifylens.recordJudgment",
          "when": "view == verifylens.requirements && viewItem == requirement",
          "group": "inline@2"
        },
        {
          "command": "verifylens.focusRequirement",
          "when": "view == verifylens.requirements && viewItem == requirement",
          "group": "1_req@1"
        },
        {
          "command": "verifylens.openDiff",
          "when": "view == verifylens.requirements && viewItem == requirement",
          "group": "1_req@2"
        },
        {
          "command": "verifylens.recordJudgment",
          "when": "view == verifylens.requirements && viewItem == requirement",
          "group": "1_req@3"
        }
      ]
    },
    "configuration": {
      "title": "VerifyLens",
      "properties": {
        "verifylens.language": {
          "type": "string",
          "enum": [
            "auto",
            "ko",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.ko%",
            "%config.language.en%"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "verifylens.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Base branch to compare against. Empty: ask (main / master first)."
        },
        "verifylens.requirementsFile": {
          "type": "string",
          "default": ".verifylens/requirements.md",
          "description": "Requirements file, relative to the repository root."
        },
        "verifylens.junitPath": {
          "type": "string",
          "default": "",
          "description": "Test report to read and write (JUnit XML, or Jest/Vitest JSON), relative to the repository root. Empty: .verifylens/test-report.xml (or .json)."
        },
        "verifylens.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node.js 22.18+ used to run the demo's tests. If unavailable, the demo uses bundled test results."
        },
        "verifylens.autoRerun": {
          "type": "boolean",
          "default": true,
          "description": "Re-run automatically when you commit, switch branches, or when the requirements file or the JUnit report changes."
        },
        "verifylens.inlineNotes": {
          "type": "boolean",
          "default": true,
          "description": "%config.inlineNotes%"
        },
        "verifylens.problems": {
          "type": "boolean",
          "default": true,
          "description": "List lines that need attention in the Problems panel, so F8 jumps to the next one."
        },
        "verifylens.summaryLanguage": {
          "type": "string",
          "enum": [
            "auto",
            "ko",
            "en"
          ],
          "default": "auto",
          "description": "%config.summaryLanguage%"
        },
        "verifylens.ghPath": {
          "type": "string",
          "default": "gh",
          "description": "GitHub CLI used by \"Import requirements\" to read a PR or issue. Only the text is read; your code is not sent."
        },
        "verifylens.includeUncommitted": {
          "type": "boolean",
          "default": true,
          "description": "When checking the current branch, also look at changes you have not committed yet (and re-check when a file is saved). Turn off to look at committed changes only."
        },
        "verifylens.testCommand": {
          "type": "string",
          "default": "",
          "description": "Command that runs your tests and writes a JUnit XML (or Jest/Vitest JSON) report to ${report}. Empty: detected from package.json (Vitest, Jest, node:test). Example: npx mocha --reporter xunit --reporter-option output=${report}"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test test/model.test.ts test/cases.test.ts test/ci.test.ts test/edits.test.ts test/display.test.ts ../web/check.test.ts ../web/pr.test.ts && node test/smoke.cjs && node ../tools/build-cli.mjs --check",
    "package": "node build.mjs && vsce package --no-dependencies",
    "test:vscode": "node test/integration/run.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
