{
  "name": "verifylens",
  "displayName": "VerifyLens",
  "description": "See per requirement whether an AI-generated change is verified, different, or not yet verified — linked to code lines and the tests that ran. Local, no LLM.",
  "version": "0.3.0",
  "publisher": "damun",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/DamunKorea/verifylens"
  },
  "homepage": "https://github.com/DamunKorea/verifylens",
  "bugs": {
    "url": "https://github.com/DamunKorea/verifylens/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode only the demo runs. Checking or comparing branches reads your repository with git and needs a trusted folder.",
      "restrictedConfigurations": [
        "verifylens.nodePath",
        "verifylens.junitPath",
        "verifylens.requirementsFile"
      ]
    }
  },
  "categories": [
    "Testing",
    "Linters",
    "Other"
  ],
  "keywords": [
    "ai",
    "verification",
    "code review",
    "requirements",
    "copilot",
    "cursor"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "verifylens.runDemo",
        "title": "Run demo (sample login-lockout case)",
        "category": "VerifyLens",
        "icon": "$(play)"
      },
      {
        "command": "verifylens.checkBranch",
        "title": "Check current branch",
        "category": "VerifyLens",
        "icon": "$(search)"
      },
      {
        "command": "verifylens.compareBranches",
        "title": "Compare two branches",
        "category": "VerifyLens",
        "icon": "$(git-compare)"
      },
      {
        "command": "verifylens.openReport",
        "title": "Open report",
        "category": "VerifyLens",
        "icon": "$(preview)"
      },
      {
        "command": "verifylens.createRequirements",
        "title": "Create requirements file",
        "category": "VerifyLens",
        "icon": "$(new-file)"
      },
      {
        "command": "verifylens.rerun",
        "title": "Run again",
        "category": "VerifyLens",
        "icon": "$(refresh)"
      },
      {
        "command": "verifylens.focusRequirement",
        "title": "Show evidence for a requirement",
        "category": "VerifyLens",
        "icon": "$(preview)",
        "enablement": "verifylens.hasRun"
      },
      {
        "command": "verifylens.openDiff",
        "title": "Compare side by side (A ↔ B, or base ↔ branch)",
        "category": "VerifyLens",
        "icon": "$(git-compare)",
        "enablement": "verifylens.hasRun"
      },
      {
        "command": "verifylens.recordJudgment",
        "title": "Record my decision (use / fix / verify more / hold)",
        "category": "VerifyLens",
        "icon": "$(checklist)",
        "enablement": "verifylens.hasRun"
      },
      {
        "command": "verifylens.copySummary",
        "title": "Copy verification summary for a PR",
        "category": "VerifyLens",
        "icon": "$(clippy)",
        "enablement": "verifylens.hasRun"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "verifylens",
          "title": "VerifyLens",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "verifylens": [
        {
          "id": "verifylens.requirements",
          "name": "Requirements"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "verifylens.requirements",
        "when": "isWorkspaceTrusted",
        "contents": "AI가 만든 변경이 요구사항마다 확인됨 · 다름 · 미확인인지 보여 줍니다. 코드는 이 PC 밖으로 나가지 않습니다.\n[샘플로 해 보기](command:verifylens.runDemo)\n[지금 브랜치 확인](command:verifylens.checkBranch)\n[두 브랜치 비교](command:verifylens.compareBranches)\n요구사항 파일이 없으면 [요구사항 파일 만들기](command:verifylens.createRequirements)"
      },
      {
        "view": "verifylens.requirements",
        "when": "!isWorkspaceTrusted",
        "contents": "AI가 만든 변경이 요구사항마다 확인됨 · 다름 · 미확인인지 보여 줍니다. 코드는 이 PC 밖으로 나가지 않습니다.\n[샘플로 해 보기](command:verifylens.runDemo)\n이 폴더는 아직 신뢰하지 않은 상태(제한 모드)라 내 브랜치 확인은 꺼져 있습니다.\n[이 폴더 신뢰하기](command:workbench.trust.manage)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "verifylens.copySummary",
          "when": "view == verifylens.requirements && verifylens.hasRun",
          "group": "navigation@0"
        },
        {
          "command": "verifylens.rerun",
          "when": "view == verifylens.requirements && verifylens.hasRun",
          "group": "navigation@1"
        },
        {
          "command": "verifylens.openReport",
          "when": "view == verifylens.requirements && verifylens.hasRun",
          "group": "navigation@2"
        },
        {
          "command": "verifylens.checkBranch",
          "when": "view == verifylens.requirements",
          "group": "1_run@1"
        },
        {
          "command": "verifylens.compareBranches",
          "when": "view == verifylens.requirements",
          "group": "1_run@2"
        },
        {
          "command": "verifylens.runDemo",
          "when": "view == verifylens.requirements",
          "group": "1_run@3"
        }
      ],
      "view/item/context": [
        {
          "command": "verifylens.openDiff",
          "when": "view == verifylens.requirements && viewItem == requirement",
          "group": "inline@1"
        },
        {
          "command": "verifylens.recordJudgment",
          "when": "view == verifylens.requirements && viewItem == requirement",
          "group": "inline@2"
        },
        {
          "command": "verifylens.focusRequirement",
          "when": "view == verifylens.requirements && viewItem == requirement",
          "group": "1_req@1"
        },
        {
          "command": "verifylens.openDiff",
          "when": "view == verifylens.requirements && viewItem == requirement",
          "group": "1_req@2"
        },
        {
          "command": "verifylens.recordJudgment",
          "when": "view == verifylens.requirements && viewItem == requirement",
          "group": "1_req@3"
        }
      ]
    },
    "configuration": {
      "title": "VerifyLens",
      "properties": {
        "verifylens.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Base branch to compare against. Empty: ask (main / master first)."
        },
        "verifylens.requirementsFile": {
          "type": "string",
          "default": ".verifylens/requirements.md",
          "description": "Requirements file, relative to the repository root."
        },
        "verifylens.junitPath": {
          "type": "string",
          "default": "",
          "description": "Optional JUnit XML test report for the checked branch, relative to the repository root."
        },
        "verifylens.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node.js 22.18+ used to run the demo's tests. If unavailable, the demo uses bundled test results."
        },
        "verifylens.autoRerun": {
          "type": "boolean",
          "default": true,
          "description": "Re-run automatically when you commit, switch branches, or when the requirements file or the JUnit report changes."
        },
        "verifylens.inlineNotes": {
          "type": "boolean",
          "default": true,
          "description": "Show a short note at the end of each evidence line (for example \"← R2 · 다름 · 6번째 시도에 동작\")."
        },
        "verifylens.problems": {
          "type": "boolean",
          "default": true,
          "description": "List lines that need attention in the Problems panel, so F8 jumps to the next one."
        },
        "verifylens.summaryLanguage": {
          "type": "string",
          "enum": [
            "ko",
            "en"
          ],
          "default": "ko",
          "description": "Language of the PR verification summary copied by \"Copy verification summary for a PR\"."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test test/model.test.ts && node test/smoke.cjs",
    "package": "node build.mjs && vsce package --no-dependencies",
    "test:vscode": "node test/integration/run.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
